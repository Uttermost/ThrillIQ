# Firebase Web app config for the `thrilliq` Firebase project — the same
# "Web" app registered for web-admin (see web-admin/.env.example), reused
# here since the consumer web build talks to the same Firestore project.
# These values identify the project to the client SDK; they aren't secrets
# (access is controlled by firestore.rules and Auth's authorized-domains
# list, not by keeping this out of git — same reasoning google-services.json's
# checked-in api_key relies on), so real values live here rather than behind
# a per-developer .env.local.
# `cp .env.example .env` and `npx expo start --web` works as-is.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBamJFZ27102BRlN7UJwpwzX4gwgzPoh3E
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=thrilliq.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=thrilliq
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=thrilliq.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=530380846105
EXPO_PUBLIC_FIREBASE_APP_ID=1:530380846105:web:59729ace89b7ea32bae688
