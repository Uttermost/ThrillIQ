# Firebase Web app config for the `thrilliq` Firebase project — the "Web"
# app registered alongside the mobile app's Android one (see
# ../google-services.json). These values identify the project to the client
# SDK; they aren't secrets (access is controlled by firestore.rules and
# Auth's authorized-domains list, not by keeping this out of git — same
# reasoning google-services.json's checked-in api_key relies on), so real
# values live here rather than behind a per-developer .env.local.
# `cp .env.example .env.local` and it works as-is.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBamJFZ27102BRlN7UJwpwzX4gwgzPoh3E
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=thrilliq.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=thrilliq
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=thrilliq.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=530380846105
NEXT_PUBLIC_FIREBASE_APP_ID=1:530380846105:web:59729ace89b7ea32bae688
