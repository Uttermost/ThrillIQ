# Firebase Web app config for the `thrilliq` Firebase project.
# Register a "Web" app in the Firebase console (Project settings → General →
# Your apps → Add app → Web) if one doesn't already exist — the mobile app
# only registered an Android app (see ../google-services.json), so this is a
# separate app registration with its own client-side config values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=thrilliq.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=thrilliq
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=thrilliq.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=530380846105
NEXT_PUBLIC_FIREBASE_APP_ID=
