rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /adventures/{adventureId} {
      // Adventures are the public "homepage" — browsable by anyone, signed
      // in or not. Every write below still requires auth.
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.spotsFilled == 0
        && request.resource.data.participantIds == []
        && request.resource.data.likedBy == []
        && request.resource.data.likeCount == 0;

      // Organizer can edit their own listing (title/date/etc.), but not
      // touch capacity, participants, or likes through this path — those
      // only change via the narrower join/leave/like rules below.
      allow update: if request.auth != null
        && resource.data.organizerId == request.auth.uid
        && request.resource.data.organizerId == resource.data.organizerId
        && request.resource.data.spotsFilled == resource.data.spotsFilled
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.likedBy == resource.data.likedBy
        && request.resource.data.likeCount == resource.data.likeCount;

      // Join: add yourself to participantIds and bump spotsFilled by
      // exactly one, without exceeding capacity. Nothing else may change.
      allow update: if request.auth != null
        && request.resource.data.participantIds == resource.data.participantIds.concat([request.auth.uid])
        && !resource.data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.spotsFilled == resource.data.spotsFilled + 1
        && request.resource.data.spotsFilled <= resource.data.spotsTotal
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'spotsFilled']);

      // Leave: remove yourself, drop spotsFilled by exactly one.
      allow update: if request.auth != null
        && resource.data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.participantIds == resource.data.participantIds.removeAll([request.auth.uid])
        && request.resource.data.spotsFilled == resource.data.spotsFilled - 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'spotsFilled']);

      // Like/unlike: only your own id may enter or leave likedBy, and
      // likeCount must move by exactly one in the matching direction.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
        && (
          (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid])
            && !resource.data.likedBy.hasAny([request.auth.uid])
            && request.resource.data.likeCount == resource.data.likeCount + 1)
          ||
          (request.resource.data.likedBy == resource.data.likedBy.removeAll([request.auth.uid])
            && resource.data.likedBy.hasAny([request.auth.uid])
            && request.resource.data.likeCount == resource.data.likeCount - 1)
        );

      allow delete: if request.auth != null && resource.data.organizerId == request.auth.uid;
    }

    match /users/{uid} {
      // "Everyone" is enforceable now. "Connections" and "Participants" tiers
      // are NOT — there's no Connections collection yet (Phase 2) to check
      // "is this requester actually a connection" against. Fails closed: a
      // profile set to those tiers is readable only by its own owner until
      // Phase 2 lands and this rule can be tightened to actually check it,
      // rather than pretending to enforce a tier it can't yet verify.
      allow get: if resource.data.privacy.profileVisibility == 'Everyone'
        || (request.auth != null && request.auth.uid == uid);

      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      // No `list` on this collection: every real lookup already knows the
      // uid (from an adventure's organizerId/participantIds), so there's no
      // legitimate reason to allow enumerating all profiles.
    }
  }
}
