rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /adventures/{adventureId} {
      // Adventures are the public "homepage" — browsable by anyone, signed
      // in or not. Every write below still requires auth.
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.spotsFilled == 0
        && request.resource.data.participantIds == []
        && request.resource.data.likedBy == []
        && request.resource.data.likeCount == 0;

      // Organizer can edit their own listing (title/date/etc.), but not
      // touch capacity, participants, or likes through this path — those
      // only change via the narrower join/leave/like rules below.
      allow update: if request.auth != null
        && resource.data.organizerId == request.auth.uid
        && request.resource.data.organizerId == resource.data.organizerId
        && request.resource.data.spotsFilled == resource.data.spotsFilled
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.likedBy == resource.data.likedBy
        && request.resource.data.likeCount == resource.data.likeCount;

      // Join: add yourself to participantIds and bump spotsFilled by
      // exactly one, without exceeding capacity. Nothing else may change.
      allow update: if request.auth != null
        && request.resource.data.participantIds == resource.data.participantIds.concat([request.auth.uid])
        && !resource.data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.spotsFilled == resource.data.spotsFilled + 1
        && request.resource.data.spotsFilled <= resource.data.spotsTotal
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'spotsFilled']);

      // Leave: remove yourself, drop spotsFilled by exactly one.
      allow update: if request.auth != null
        && resource.data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.participantIds == resource.data.participantIds.removeAll([request.auth.uid])
        && request.resource.data.spotsFilled == resource.data.spotsFilled - 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'spotsFilled']);

      // Like/unlike: only your own id may enter or leave likedBy, and
      // likeCount must move by exactly one in the matching direction.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
        && (
          (request.resource.data.likedBy == resource.data.likedBy.concat([request.auth.uid])
            && !resource.data.likedBy.hasAny([request.auth.uid])
            && request.resource.data.likeCount == resource.data.likeCount + 1)
          ||
          (request.resource.data.likedBy == resource.data.likedBy.removeAll([request.auth.uid])
            && resource.data.likedBy.hasAny([request.auth.uid])
            && request.resource.data.likeCount == resource.data.likeCount - 1)
        );

      allow delete: if request.auth != null && resource.data.organizerId == request.auth.uid;
    }

    match /crews/{crewId} {
      // Crews are publicly browsable, like adventures.
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Join: add yourself only, nothing else may change.
      allow update: if request.auth != null
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
        && !resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);

      // Leave: remove yourself only. An owner leaving their own crew (rather
      // than deleting it) is a known gap — ownership transfer/hand-off isn't
      // built, so an ownerless-but-still-existing crew is possible today.
      allow update: if request.auth != null
        && resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);

      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      // Reviews are shown on an organizer's public profile — readable by
      // anyone. Doc id is deterministic (`${adventureId}_${reviewerId}`),
      // so a duplicate submission overwrite-attempts here would be an
      // `update`, which is denied below — one review per participant per
      // adventure by construction, not by app-side bookkeeping.
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 600
        && reviewId == request.resource.data.adventureId + '_' + request.auth.uid
        && get(/databases/$(database)/documents/adventures/$(request.resource.data.adventureId)).data.organizerId == request.resource.data.organizerId
        && get(/databases/$(database)/documents/adventures/$(request.resource.data.adventureId)).data.participantIds.hasAny([request.auth.uid])
        && get(/databases/$(database)/documents/adventures/$(request.resource.data.adventureId)).data.dateTimestamp < request.time.toMillis();

      allow update: if false;
      allow delete: if false;
    }

    match /acknowledgements/{ackId} {
      // No more sensitive than the adventure's own public participantIds —
      // who joined is already visible there. This just adds a timestamped
      // record of guidelines agreement for that same, already-public fact.
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && ackId == request.resource.data.adventureId + '_' + request.auth.uid
        && get(/databases/$(database)/documents/adventures/$(request.resource.data.adventureId)).data.participantIds.hasAny([request.auth.uid]);

      allow update: if false;
      allow delete: if false;
    }

    match /users/{uid} {
      // "Everyone" is enforceable now. "Connections" and "Participants" tiers
      // are NOT — there's no Connections collection yet (Phase 2) to check
      // "is this requester actually a connection" against. Fails closed: a
      // profile set to those tiers is readable only by its own owner until
      // Phase 2 lands and this rule can be tightened to actually check it,
      // rather than pretending to enforce a tier it can't yet verify.
      allow get: if resource.data.privacy.profileVisibility == 'Everyone'
        || (request.auth != null && request.auth.uid == uid);

      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      // No `list` on this collection: every real lookup already knows the
      // uid (from an adventure's organizerId/participantIds), so there's no
      // legitimate reason to allow enumerating all profiles.
    }
  }
}
